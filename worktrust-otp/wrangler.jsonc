{
  "name": "worktrust-otp",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "kv_namespaces": [
    {
      "binding": "OTP_STORE",
      "id": "cc60bc364ed4451e8e19c1a5500a7168"
    }
  ],

  "vars": {
    "ENVIRONMENT": "development"
  },

  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      },
      "kv_namespaces": [
        {
          "binding": "OTP_STORE",
          "id": "cc60bc364ed4451e8e19c1a5500a7168"
        }
      ]
    }
  }
}